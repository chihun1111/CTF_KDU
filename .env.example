NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
# Compose bind paths are relative to infra/docker/docker-compose.yml.
NGINX_CONFIG_FILE=../nginx/nginx.conf

POSTGRES_DB=campus_ctf
POSTGRES_USER=campus_ctf
REDIS_URL=redis://redis:6379
RUNTIME_SECRETS_DIR=../../secrets/runtime-only

DATABASE_PASSWORD_FILE=./secrets/runtime-only/postgres_password
POSTGRES_PASSWORD_FILE=./secrets/runtime-only/postgres_password
FLAG_ENCRYPTION_KEY_FILE=./secrets/runtime-only/flag_encryption_key
FLAG_HASH_PEPPER_FILE=./secrets/runtime-only/flag_hash_pepper
STUDENT_ID_ENCRYPTION_KEY_FILE=./secrets/runtime-only/student_id_encryption_key
STUDENT_ID_HASH_PEPPER_FILE=./secrets/runtime-only/student_id_hash_pepper
SESSION_SECRET_FILE=./secrets/runtime-only/session_secret
CLEAR_VIEW_TOKEN_SECRET_FILE=./secrets/runtime-only/clear_view_token_secret
CLAIM_TOKEN_SECRET_FILE=./secrets/runtime-only/claim_token_secret
INTERNAL_SERVICE_TOKEN_01_FILE=./secrets/runtime-only/internal_service_token_01
INTERNAL_SERVICE_TOKEN_02_FILE=./secrets/runtime-only/internal_service_token_02
INTERNAL_SERVICE_TOKEN_03_FILE=./secrets/runtime-only/internal_service_token_03
INTERNAL_SERVICE_TOKEN_04_FILE=./secrets/runtime-only/internal_service_token_04
INTERNAL_SERVICE_TOKEN_05_FILE=./secrets/runtime-only/internal_service_token_05
INTERNAL_SERVICE_TOKEN_06_FILE=./secrets/runtime-only/internal_service_token_06
INTERNAL_SERVICE_TOKEN_07_FILE=./secrets/runtime-only/internal_service_token_07
INTERNAL_SERVICE_TOKEN_08_FILE=./secrets/runtime-only/internal_service_token_08
