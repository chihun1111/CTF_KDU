{
  "name": "campus-ctf-2026",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "preflight:deploy": "node scripts/deployment-preflight.mjs",
    "smoke:admin": "node scripts/runtime-admin-smoke.mjs",
    "smoke:challenges": "node scripts/runtime-challenge-smoke.mjs",
    "smoke:clear": "node scripts/runtime-clear-smoke.mjs",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "secrets:generate": "node scripts/generate-runtime-secrets.mjs",
    "test": "pnpm verify:workspace && pnpm verify:docs && pnpm verify:ui && node --test scripts/*.test.mjs && pnpm --filter @campus-ctf/config build && pnpm --filter @campus-ctf/db build && pnpm --filter @campus-ctf/shared build && pnpm -r --if-present test",
    "verify:compose": "node scripts/verify-compose-static.mjs",
    "verify:docs": "node scripts/verify-doc-links.mjs",
    "verify:compose-runtime": "node scripts/verify-compose-runtime.mjs",
    "verify:images": "node scripts/verify-docker-image-pulls.mjs",
    "verify:secrets": "node scripts/verify-runtime-secrets.mjs",
    "verify:sensitive": "node scripts/verify-sensitive-artifacts.mjs",
    "verify:ui": "node scripts/verify-ui-doc-policy.mjs",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
